# Container images
GHCR_NAMESPACE=your-github-owner
GHCR_REPOSITORY=houseviewing
IMAGE_TAG=latest

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=house_viewing
MYSQL_USER=house_viewing
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Spring Boot
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
AWS_ACCESS_KEY=replace-with-aws-access-key
AWS_SECRET_KEY=replace-with-aws-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=house-viewing-storage
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# FastAPI OCR / public-data integrations
API_URL=https://replace-with-ocr-api-endpoint
SECRET_KEY=replace-with-ocr-secret-key
RTMS_SERVICE_KEY=replace-with-public-data-service-key
RTMS_RH_TRADE_URL=https://replace-with-row-house-trade-api
RTMS_SH_TRADE_URL=https://replace-with-apartment-trade-api
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_FALLBACK_ENABLED=false
PROPERTY_TYPE=
